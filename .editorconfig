root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,ps1}]
end_of_line = crlf

[scripts/{app,compose-context,project-runtime,setup-local,mq-bootstrap}.ps1]
charset = utf-8-bom
